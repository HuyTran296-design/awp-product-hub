# AWP Product Hub — environment variables (copy to .env for local use; never commit real values).

# Database file. ":memory:" = no file, the sample data is seeded on every start (used on Vercel).
# Local default when unset: data/awp-hub.db
AWP_DB=:memory:

# 64 hex characters: AES-256-GCM key for stored connector credentials (.p8 keys, service-account JSON).
# Local default when unset: generated into data/secret.key
AWP_SECRET_KEY=

# Random string that signs the session cookie, so sessions survive restarts and work across server instances.
AWP_SESSION_SECRET=

# Optional (local only): HTTP port, default 4310.
# PORT=4310

# Optional: simulate another "today" (YYYY-MM-DD) for demos / acceptance checks.
# AWP_TODAY=2026-11-04

