{
  "name": "awp-product-hub",
  "version": "0.1.0",
  "private": true,
  "description": "AWP Product Hub prototype — hiệu quả & chi phí dự án sản phẩm team AWP (ABC Digital)",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "reset-db": "node --disable-warning=ExperimentalWarning server/index.js --reset --no-listen",
